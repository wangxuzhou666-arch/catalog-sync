# Copy to deploy/.env (git-ignored) and give every variable below a value. Docker Compose reads
# deploy/.env next to compose.yaml and refuses to start while one of them is empty, so a stack
# with a forgotten secret does not come up with a default one.
#
# Generate a value with `openssl rand -hex 16`: hex keeps the database password safe to put
# inside a connection string, which these characters need.
# Nothing here is a real credential, and the real file must never be committed or baked into an image.

# The account of the Mock SaaS (the demo's stand-in for the service you read from). The login
# one-shot posts it to the mock's login form; the scheduler never sees it.
MOCK_SAAS_USER=
MOCK_SAAS_PASSWORD=

# The bearer token the reference platform accepts, and the sink presents.
PLATFORM_TOKEN=

# The Postgres administrator (used by the image and by you, never by catalog-sync) ...
POSTGRES_PASSWORD=
# ... and the restricted role catalog-sync loads as (postgres-init.sh creates it on the first start).
CATALOG_SYNC_DB_PASSWORD=
