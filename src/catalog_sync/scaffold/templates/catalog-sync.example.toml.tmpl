# Example configuration for the {{title}} connector: copy what you need into your catalog-sync.toml
# (which is git-ignored). Credentials never go in this file.

[sources.{{name}}-items]
plugin = "{{source_name}}"
credential = "{{name}}"
page_size = 50
request_gap_s = 1.0                 # a floor between requests; at least 60 / max_requests_per_minute

# The tool refuses to contact the service until the five placeholders below are replaced with the
# truth about YOUR use: who owns the data, on what authority it is read, which terms you reviewed
# and when. It checks that the block is there and consistent; it cannot check that it is honest.
[sources.{{name}}-items.compliance]
data_owner = "<the organisation whose data this is>"
authorization = "<own_account | customer_authorized | contract | public_data>"
authorization_ref = "<where the grant is recorded: a ticket, a wiki page, a contract number>"
tos_url = "<the terms of service you reviewed>"
tos_reviewed_on = "<YYYY-MM-DD, the day you read them>"
max_requests_per_minute = 60        # a conservative start; raise it only if the service says it can take more
retention_days = 90                 # how long the raw cache may be kept; `cache purge` enforces it

[credentials.{{name}}]
{{toml_credential}}

[sinks.{{name}}-db]
kind = "sqlite"
path = "./out/{{name}}.db"
table = "{{name}}_items"

[profiles.{{name}}]
source = "{{name}}-items"
mapping = "src/{{package}}/mappings/{{entity}}.yaml"
sinks = ["{{name}}-db"]
incremental = true
