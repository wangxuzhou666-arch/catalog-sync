    def list_items(self, offset: int, limit: int) -> OffsetPage:
        payload = self._client.get_json(
            f"{self._base_url}{LIST_PATH}", params={"offset": offset, "limit": limit}
        )
        with shape_context(f"{LIST_PATH} at offset {offset}"):
            return parse_list_page(payload)

    def first_page(self) -> OffsetPage:
        """One cheap call that needs the credential: what `login` checks a new credential with."""
        return self.list_items(0, self._page_size)

#@ api_parse
def parse_list_page(payload: Mapping[str, object]) -> OffsetPage:
    """TODO(connector): where the rows and the total (if the service says) sit in the answer."""
    require_state_ok(payload)
    return offset_page(peel_data(payload, 1), where="data", rows_key="items", total_key="total")

