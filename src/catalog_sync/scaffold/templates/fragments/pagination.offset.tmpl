    def _list(self, request: RecordedRequest) -> FakeResponse:
        offset, limit = int(request.query["offset"]), int(request.query["limit"])
        rows = [list_row(item) for item in self.items[offset : offset + limit]]
        return FakeResponse.json(envelope({"items": rows, "total": len(self.items)}))
