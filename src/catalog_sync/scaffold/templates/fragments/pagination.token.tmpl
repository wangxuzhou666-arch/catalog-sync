    def _list(self, request: RecordedRequest) -> FakeResponse:
        limit = int(request.query["limit"])
        start = int(request.query.get("cursor", "cur-0").removeprefix("cur-"))
        rows = [list_row(item) for item in self.items[start : start + limit]]
        has_more = start + limit < len(self.items)
        next_cursor = f"cur-{start + limit}" if has_more else None
        return FakeResponse.json(envelope({"items": rows, "next_cursor": next_cursor}))
