    def list_items(self, token: str | None) -> TokenPage:
        params: dict[str, str | int] = {"limit": self._page_size}
        if token is not None:
            params["cursor"] = token
        payload = self._client.get_json(f"{self._base_url}{LIST_PATH}", params=params)
        with shape_context(f"{LIST_PATH} after cursor {token!r}"):
            return parse_list_page(payload)

    def first_page(self) -> TokenPage:
        """One cheap call that needs the credential: what `login` checks a new credential with."""
        return self.list_items(None)

#@ api_parse
def parse_list_page(payload: Mapping[str, object]) -> TokenPage:
    """TODO(connector): where the rows and the next-page token sit in the answer."""
    require_state_ok(payload)
    return token_page(peel_data(payload, 1), where="data", rows_key="items", next_key="next_cursor")

