#@ fake_login_method
    def _login(self, request: RecordedRequest) -> FakeResponse:
        if request.json_body() != ACCOUNT:
            return FakeResponse(401)
        cookie = f"{AUTH_VALUE}; Path=/; HttpOnly"
        return FakeResponse.json(envelope({}), headers={"Set-Cookie": cookie})

