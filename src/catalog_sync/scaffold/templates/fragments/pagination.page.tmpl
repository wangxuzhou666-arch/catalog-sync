    def list_items(self, page: int) -> RowPage:
        payload = self._client.get_json(
            f"{self._base_url}{LIST_PATH}", params={"page": page, "per_page": self._page_size}
        )
        with shape_context(f"{LIST_PATH} page {page}"):
            return parse_list_page(payload)

    def first_page(self) -> RowPage:
        """One cheap call that needs the credential: what `login` checks a new credential with."""
        return self.list_items(1)

#@ api_parse
def parse_list_page(payload: Mapping[str, object]) -> RowPage:
    """TODO(connector): where the rows and the total sit in the answer."""
    require_state_ok(payload)
    return rows_page(peel_data(payload, 1), where="data", total_key="total", rows_key="rows")

