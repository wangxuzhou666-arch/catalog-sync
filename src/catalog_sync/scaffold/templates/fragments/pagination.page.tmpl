    def _list(self, request: RecordedRequest) -> FakeResponse:
        page, per_page = int(request.query["page"]), int(request.query["per_page"])
        window = self.items[(page - 1) * per_page : page * per_page]
        rows = [list_row(item) for item in window]
        return FakeResponse.json(envelope({"rows": rows, "total": len(self.items)}))
