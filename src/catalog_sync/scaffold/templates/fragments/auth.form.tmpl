LOGIN_PATH = "/api/login"
ACCOUNT = {"username": "demo", "password": "demo-password"}

#@ fake_login
        if request.path == LOGIN_PATH:
            return self._login(request)
#@ fake_login_method
    def _login(self, request: RecordedRequest) -> FakeResponse:
        if request.json_body() != ACCOUNT:
            return FakeResponse(401)
        return FakeResponse.json(envelope({"token": AUTH_VALUE.removeprefix("Bearer ")}))

