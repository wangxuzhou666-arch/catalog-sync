"""The {{title}} credential: a bearer token.

TODO(connector): the token is whatever the web app sends in its ``Authorization`` header. There are
two ways to get one into the credential store, and this tool does neither behind your back:

* ``catalog-sync login {{name}} --paste-curl -``: copy any authenticated API call from
  the browser's network tab with "Copy as cURL (bash)", paste it, press Ctrl-D.
* ``catalog-sync login {{name}} --browser``: a browser opens the web app, the login form
  is filled from the environment variables ``USER_ENV`` and ``PASSWORD_ENV`` below, and
  the token the app's own calls carry is taken. If the service asks for a person (a captcha, a code)
  add ``--headed`` and log in by hand: the tool only takes the token.

The addresses and selectors below belong to a login page that does not exist; replace them with
the real page's. Nothing is disguised: the browser says what it is, and nothing is rotated.
"""

from __future__ import annotations

from collections.abc import Mapping
from functools import partial
from pathlib import Path
from urllib.parse import urlsplit

from catalog_sync.credentials.base import Credential
from catalog_sync.credentials.browser import BrowserSite
from catalog_sync.credentials.kind import CredentialKind
from catalog_sync.http import HttpSeams
from catalog_sync.sdk import EnvAccount, OptionReader, header_layout, verify_with_probe

from {{package}}.api import (
    {{class_prefix}}Api,
    api_headers,
)
from {{package}}.settings import DEFAULT_BASE_URL

USER_ENV = "{{env_prefix}}_USER"
PASSWORD_ENV = "{{env_prefix}}_PASSWORD"  # noqa: S105 — the name of an environment variable
TOKEN_KEY = "AUTHORIZATION"  # noqa: S105 — the name of a key in the credential file

# TODO(connector): the page a browser login starts from, and its form, as the browser shows them.
LANDING_PATH = "/app"
USER_SELECTOR = "#username"
PASSWORD_SELECTOR = "#password"  # noqa: S105 — a CSS selector
SUBMIT_SELECTOR = "button[type=submit]"
LOGIN_URL_MARKERS = ("login", "signin")  # lower-case parts of the login page's address

account_from_env = EnvAccount(USER_ENV, PASSWORD_ENV)


def {{name}}_credential_kind(
    options: Mapping[str, object],
    *,
    base_dir: Path,
) -> CredentialKind:
    """Entry point of the ``{{name}}`` credential kind."""
    del base_dir  # nothing here is a path
    reader = OptionReader(options, label="credential kind {{name}}")
    reader.reject_unknown({"base_url"})
    base_url = reader.base_url(DEFAULT_BASE_URL)
    host = urlsplit(base_url).hostname or ""
    return CredentialKind(
        name="{{name}}",
        layout=header_layout(host, key=TOKEN_KEY, header="authorization"),
        browser=BrowserSite(
            landing_url=f"{base_url}{LANDING_PATH}",
            host_suffix=host,
            locale="en-US",
            user_selector=USER_SELECTOR,
            password_selector=PASSWORD_SELECTOR,
            submit_selector=SUBMIT_SELECTOR,
            login_url_markers=LOGIN_URL_MARKERS,
        ),
        verify=partial(verify_live, base_url=base_url),
        account=account_from_env,
    )


def verify_live(credential: Credential, *, base_url: str, seams: HttpSeams | None = None) -> None:
    """Prove a credential works by asking for one page. HTTP 200 alone is not enough: the answer
    must have the shape of a list page (parse_list_page)."""
    verify_with_probe(
        api_headers(credential),
        lambda client: {{class_prefix}}Api(client, base_url=base_url, page_size=1).first_page(),
        seams=seams,
    )
