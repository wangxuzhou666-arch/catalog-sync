LIST_PATH = "/api/v1/items"  # TODO(connector): the list endpoint
DETAIL_PATH = "/api/v1/items/{item_id}"  # TODO(connector): the detail endpoint


def api_headers(credential: Credential) -> Mapping[str, str]:
    """What every call carries: the tool's own user agent and the credential's headers."""
    return {"accept": "application/json", "user-agent": USER_AGENT, **credential.headers}


class {{class_prefix}}Api:
    def __init__(self, client: HttpClient, *, base_url: str, page_size: int) -> None:
        self._client = client
        self._base_url = base_url
        self._page_size = page_size

{{api_list}}

    def item_detail(self, item_id: str) -> JsonObject:
        path = DETAIL_PATH.format(item_id=quote(item_id, safe=""))
        payload = self._client.get_json(f"{self._base_url}{path}")
        with shape_context(f"detail of item {item_id}"):
            return parse_detail(payload)


