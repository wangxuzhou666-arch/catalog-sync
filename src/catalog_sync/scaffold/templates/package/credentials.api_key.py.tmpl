"""The {{title}} credential: an API key sent in a request header.

TODO(connector): name the header the service documents (``API_KEY_HEADER``). The key gets
into the credential store with ``catalog-sync login {{name}} --paste-curl -`` (a cURL
command that carries the header) or by writing the file yourself: a line
``API_KEY=<the key>`` in ``<workspace>/credentials/{{name}}.cred``, readable by you
only. There is no login to automate and no expiry to read, so ``auth status`` says ``unknown``.
"""

from __future__ import annotations

from collections.abc import Mapping
from functools import partial
from pathlib import Path
from urllib.parse import urlsplit

from catalog_sync.credentials.base import Credential
from catalog_sync.credentials.kind import CredentialKind
from catalog_sync.http import HttpSeams
from catalog_sync.sdk import OptionReader, header_layout, verify_with_probe

from {{package}}.api import (
    {{class_prefix}}Api,
    api_headers,
)
from {{package}}.settings import DEFAULT_BASE_URL

API_KEY_KEY = "API_KEY"  # the name of a key in the credential file
API_KEY_HEADER = "x-api-key"  # TODO(connector): the header the service reads the key from


def {{name}}_credential_kind(
    options: Mapping[str, object],
    *,
    base_dir: Path,
) -> CredentialKind:
    """Entry point of the ``{{name}}`` credential kind."""
    del base_dir  # nothing here is a path
    reader = OptionReader(options, label="credential kind {{name}}")
    reader.reject_unknown({"base_url"})
    base_url = reader.base_url(DEFAULT_BASE_URL)
    host = urlsplit(base_url).hostname or ""
    return CredentialKind(
        name="{{name}}",
        layout=header_layout(host, key=API_KEY_KEY, header=API_KEY_HEADER),
        browser=None,
        verify=partial(verify_live, base_url=base_url),
        account=lambda _env: None,  # a key is issued, not logged in with
    )


def verify_live(credential: Credential, *, base_url: str, seams: HttpSeams | None = None) -> None:
    """Prove a credential works by asking for one page. HTTP 200 alone is not enough: the answer
    must have the shape of a list page (parse_list_page)."""
    verify_with_probe(
        api_headers(credential),
        lambda client: {{class_prefix}}Api(client, base_url=base_url, page_size=1).first_page(),
        seams=seams,
    )
