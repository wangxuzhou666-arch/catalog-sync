"""The {{title}} credential: a session cookie, from logging in with one HTTP request.

TODO(connector): ``catalog-sync login {{name}} --form`` posts the account to the login
address and keeps the one cookie the answer sets (``SESSION_COOKIE``), not the whole jar.
The account comes from the environment variables ``USER_ENV`` and ``PASSWORD_ENV`` below;
the tool never reads a ``.env`` file. Every request then carries the cookie as a ``Cookie``
header. A pasted cURL command cannot be the source of a cookie: the parser drops cookies on
purpose. In the browser's network tab, find the login request and adjust: the address, the
field names, the cookie's name, and ``encoding="form"`` if it is a form post, not JSON.
"""

from __future__ import annotations

from collections.abc import Mapping
from functools import partial
from pathlib import Path
from urllib.parse import urlsplit

from catalog_sync.credentials.base import Credential
from catalog_sync.credentials.kind import CredentialKind
from catalog_sync.http import HttpSeams
from catalog_sync.sdk import EnvAccount, FormLogin, OptionReader, header_layout, verify_with_probe

from {{package}}.api import (
    {{class_prefix}}Api,
    api_headers,
)
from {{package}}.settings import DEFAULT_BASE_URL

USER_ENV = "{{env_prefix}}_USER"
PASSWORD_ENV = "{{env_prefix}}_PASSWORD"  # noqa: S105 — the name of an environment variable
COOKIE_KEY = "COOKIE"  # the name of a key in the credential file
LOGIN_PATH = "/api/login"  # TODO(connector): the address the login form posts to
SESSION_COOKIE = "session"  # TODO(connector): the cookie the service sets when you are logged in

account_from_env = EnvAccount(USER_ENV, PASSWORD_ENV)


def {{name}}_credential_kind(
    options: Mapping[str, object],
    *,
    base_dir: Path,
) -> CredentialKind:
    """Entry point of the ``{{name}}`` credential kind."""
    del base_dir  # nothing here is a path
    reader = OptionReader(options, label="credential kind {{name}}")
    reader.reject_unknown({"base_url"})
    base_url = reader.base_url(DEFAULT_BASE_URL)
    host = urlsplit(base_url).hostname or ""
    return CredentialKind(
        name="{{name}}",
        layout=header_layout(host, key=COOKIE_KEY, header="cookie"),
        browser=None,
        verify=partial(verify_live, base_url=base_url),
        account=account_from_env,
        form_login=partial(form_login, base_url=base_url),
    )


def form_login(
    env: Mapping[str, str], *, base_url: str, seams: HttpSeams | None = None
) -> Mapping[str, str]:
    """Post the account to the login address and return the credential file's values."""
    login = FormLogin(
        service="{{title}}",
        url=f"{base_url}{LOGIN_PATH}",
        account=account_from_env,
        credential_key=COOKIE_KEY,
        user_field="username",  # TODO(connector): the field names the login form posts
        password_field="password",  # noqa: S106 — a field name
        session_cookie=SESSION_COOKIE,
    )
    return login(env, seams=seams)


def verify_live(credential: Credential, *, base_url: str, seams: HttpSeams | None = None) -> None:
    """Prove a credential works by asking for one page. HTTP 200 alone is not enough: the answer
    must have the shape of a list page (parse_list_page)."""
    verify_with_probe(
        api_headers(credential),
        lambda client: {{class_prefix}}Api(client, base_url=base_url, page_size=1).first_page(),
        seams=seams,
    )
