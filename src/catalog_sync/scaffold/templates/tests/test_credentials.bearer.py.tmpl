"""Getting a bearer token into the credential store: from a pasted request, or a browser login."""

from __future__ import annotations

from pathlib import Path

import pytest
from catalog_sync.credentials.curl_paste import credential_values, parse_curl
from catalog_sync.errors import LoginFailed

from {{package}}.api import LIST_PATH
from {{package}}.credentials import {{name}}_credential_kind
from tests.fake_service import AUTH_VALUE, BASE_URL


def test_a_pasted_request_gives_the_token_and_only_for_the_services_host() -> None:
    kind = {{name}}_credential_kind({}, base_dir=Path())
    pasted = f"curl '{BASE_URL}{LIST_PATH}' -H 'authorization: {AUTH_VALUE}' -H 'x-noise: 1'"
    assert credential_values(parse_curl(pasted), kind.layout) == {"AUTHORIZATION": AUTH_VALUE}
    elsewhere = pasted.replace("https://app.", "https://other.", 1)
    with pytest.raises(LoginFailed, match="not for"):
        credential_values(parse_curl(elsewhere), kind.layout)


def test_a_browser_login_has_somewhere_to_go_and_something_to_fill() -> None:
    site = {{name}}_credential_kind({}, base_dir=Path()).browser
    assert site is not None
    assert site.is_site_host(site.landing_url) and site.landing_url.startswith(BASE_URL)
    assert site.user_selector and site.password_selector and site.submit_selector
    assert site.is_login_url(f"{BASE_URL}/login")
