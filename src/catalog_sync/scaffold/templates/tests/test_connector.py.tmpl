def test_every_entry_point_in_pyproject_points_at_something_that_exists() -> None:
    project = tomllib.loads((ROOT / "pyproject.toml").read_text(encoding="utf-8"))["project"]
    groups = project["entry-points"]
    assert set(groups) == {
        "catalog_sync.sources",
        "catalog_sync.credentials",
        "catalog_sync.connectors",
        "catalog_sync.schemas",
    }
    for group, entries in groups.items():
        for name, target in entries.items():
            module_name, _, attribute = target.partition(":")
            obj = importlib.import_module(module_name)
            for part in attribute.split("."):
                obj = getattr(obj, part)
            assert callable(obj), f"{group} {name} -> {target}"
    schema_path = importlib.import_module("{{package}}").item_schema()
    assert schema_path.is_file() and schema_path.name == "{{entity}}.yaml"
    factory = "{{package}}.source:{{class_prefix}}ItemsSource.from_options"
    assert groups["catalog_sync.sources"] == {{{class_prefix}}ItemsSource.name: factory}
