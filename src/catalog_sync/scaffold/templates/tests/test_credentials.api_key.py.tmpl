"""Getting an API key into the credential store: from a pasted request."""

from __future__ import annotations

from pathlib import Path

import pytest
from catalog_sync.credentials.curl_paste import credential_values, parse_curl
from catalog_sync.errors import LoginFailed

from {{package}}.api import LIST_PATH
from {{package}}.credentials import (
    API_KEY_HEADER,
    {{name}}_credential_kind,
)
from tests.fake_service import AUTH_HEADER, AUTH_VALUE, BASE_URL


def test_the_header_the_connector_reads_is_the_one_the_service_checks() -> None:
    assert API_KEY_HEADER == AUTH_HEADER


def test_a_pasted_request_gives_the_key_and_only_for_the_services_host() -> None:
    kind = {{name}}_credential_kind({}, base_dir=Path())
    pasted = f"curl '{BASE_URL}{LIST_PATH}' -H '{API_KEY_HEADER}: {AUTH_VALUE}' -H 'x-noise: 1'"
    assert credential_values(parse_curl(pasted), kind.layout) == {"API_KEY": AUTH_VALUE}
    elsewhere = pasted.replace("https://app.", "https://other.", 1)
    with pytest.raises(LoginFailed, match="not for"):
        credential_values(parse_curl(elsewhere), kind.layout)


def test_a_key_is_not_a_login() -> None:
    kind = {{name}}_credential_kind({}, base_dir=Path())
    env = {"{{env_prefix}}_USER": "x", "{{env_prefix}}_PASSWORD": "y"}
    assert kind.account(env) is None
    assert kind.browser is None and kind.form_login is None
