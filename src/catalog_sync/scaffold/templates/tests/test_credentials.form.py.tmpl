"""Logging in with one HTTP request: what is stored, and what a refusal looks like."""

from __future__ import annotations

from pathlib import Path

import pytest
from catalog_sync.errors import ConfigError, LoginFailed

from {{package}}.credentials import (
    {{name}}_credential_kind,
    form_login,
)
from tests.fake_service import AUTH_VALUE, BASE_URL, World

ENV = {
    "{{env_prefix}}_USER": "demo",
    "{{env_prefix}}_PASSWORD": "demo-password",
}


def test_a_login_stores_the_token_the_service_answers_with() -> None:
    world = World()
    values = form_login(ENV, base_url=BASE_URL, seams=world.seams)
    assert values == {"AUTHORIZATION": AUTH_VALUE}
    (sent,) = world.transport.requests
    assert sent.json_body() == {"username": "demo", "password": "demo-password"}
    assert sent.header("authorization") is None, "a login carries no credential"


def test_what_the_login_stored_is_accepted_by_the_service() -> None:
    world = World()
    stored = form_login(ENV, base_url=BASE_URL, seams=world.seams)
    assert stored["AUTHORIZATION"] == world.credential().headers["authorization"]


def test_a_refused_password_says_so_without_echoing_it() -> None:
    world = World()
    wrong = {**ENV, "{{env_prefix}}_PASSWORD": "guess-9999"}
    with pytest.raises(LoginFailed, match="rejected the user name or password") as caught:
        form_login(wrong, base_url=BASE_URL, seams=world.seams)
    assert "guess-9999" not in str(caught.value)
    assert len(world.transport.requests) == 1, "a refused password is not retried"


def test_half_an_account_is_an_error() -> None:
    with pytest.raises(ConfigError, match="must both be set, or neither"):
        form_login({"{{env_prefix}}_USER": "demo"}, base_url=BASE_URL)


def test_the_kind_offers_the_http_login_and_no_browser() -> None:
    kind = {{name}}_credential_kind({}, base_dir=Path())
    assert kind.form_login is not None and kind.browser is None
